# ---- FocusNest API environment (copy to server/.env and fill in) ----
# Never commit the real .env file.

NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/focusnest?retryWrites=true&w=majority

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed web origins (your Vercel URLs, plus localhost for development)
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# Web Push (VAPID) keys — generate with `npm run vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: accountability-buddy emails (any SMTP provider). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FocusNest <no-reply@example.com>"

# Optional: public URL of the web app (used in emails and push links)
APP_URL=https://your-app.vercel.app
