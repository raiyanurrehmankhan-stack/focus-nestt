# ---- FocusNest API environment ----
# Copy to server/.env for LOCAL DEVELOPMENT:   cp .env.example .env
# It works as-is with a local MongoDB and the web app on http://localhost:5173.
# Never commit the real .env file.
#
# BEFORE DEPLOYING, the production values must be set in your host's
# dashboard (e.g. Render), NOT copied from this file:
#   NODE_ENV=production                 strict checks; unsafe values stop start-up
#   MONGO_URI=<your MongoDB Atlas URI>
#   JWT_SECRET=<random secret>          openssl rand -base64 32 (Render generates it)
#   CORS_ORIGIN=https://<your web app>  exact https origin(s), comma-separated
# See README > "Production configuration".

# development | test | production. Anything else (or "Production") is refused.
# If unset, production rules apply.
NODE_ENV=development
PORT=4000

# Local MongoDB. For Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/focusnest
MONGO_URI=mongodb://127.0.0.1:27017/focusnest

# Leave empty in development to use a temporary random secret. It changes on
# every restart, which signs everyone out; set a value to keep sessions:
#   openssl rand -base64 32
# Production refuses empty, placeholder, short or low-variety secrets.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Origin of the web app. Local Vite dev server:
CORS_ORIGIN=http://localhost:5173
# Production: exact https origin(s), comma-separated, no path or trailing slash.
# Wildcards ("*") and patterns are intentionally not supported; add each
# trusted origin exactly (e.g. your Vercel staging branch alias).

# Web Push (optional). Generate keys with `npm run vapid`.
# Push stays disabled unless BOTH keys AND VAPID_SUBJECT are set.
# VAPID_SUBJECT: mailto: plus a mailbox you read on a domain you control, or
# an https:// URL you control, e.g.
#   VAPID_SUBJECT=mailto:you@example.com   (replace example.com with your own domain;
#                                           example.com is refused in production)
#   VAPID_SUBJECT=https://focus-nestt.vercel.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email for accountability-buddy notifications (optional).
# Leave SMTP_HOST, SMTP_USER and SMTP_PASS empty to keep email DISABLED.
# If you set them, MAIL_FROM is required and must be an address on a domain
# you have verified with your email provider (SPF/DKIM), for example
#   MAIL_FROM="FocusNest <no-reply@your-verified-domain>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: public URL of the web app (used in emails)
APP_URL=http://localhost:5173
