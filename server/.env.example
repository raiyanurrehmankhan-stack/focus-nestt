# ---- FocusNest API environment (copy to server/.env and fill in) ----
# Never commit the real .env file. With NODE_ENV=production the API refuses to
# start on missing or unsafe values; in development it warns and uses safe
# fallbacks. See README > "Production configuration".

NODE_ENV=production
PORT=4000

# REQUIRED. MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/focusnest?retryWrites=true&w=majority

# REQUIRED in production. Generate a random secret with:
#   openssl rand -base64 32
# Placeholders, well-known defaults, values shorter than 32 characters and
# low-variety values are rejected in production. (Render generates one for you.)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# REQUIRED in production. Exact origin(s) of the web app, comma-separated:
# https only, no path and no trailing slash. "*" is not allowed.
CORS_ORIGIN=https://your-app.vercel.app
# Optional, for Vercel preview deployments. Prefer adding your exact branch
# alias (e.g. https://your-app-git-staging-your-team.vercel.app) to
# CORS_ORIGIN instead. Patterns: https only, one "*" in the first part of the
# host, with at least 3 fixed characters on both sides, e.g.
#   CORS_ORIGIN_PATTERNS=https://your-app-*-your-team.vercel.app
CORS_ORIGIN_PATTERNS=

# Web Push (optional). Generate keys with `npm run vapid`.
# Push stays disabled unless BOTH keys AND VAPID_SUBJECT are set.
# VAPID_SUBJECT: mailto:<a mailbox you read> or an https:// URL you control,
# e.g. mailto:you@yourdomain or https://your-app.vercel.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email for accountability-buddy notifications (optional).
# Leave SMTP_HOST, SMTP_USER and SMTP_PASS empty to keep email DISABLED.
# If you set them, MAIL_FROM is required and must be an address on a domain
# you have verified with your email provider (SPF/DKIM), e.g.
#   MAIL_FROM="FocusNest <no-reply@yourdomain>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: public URL of the web app (used in emails)
APP_URL=https://your-app.vercel.app
